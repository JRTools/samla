{
  "name": "jrtools/samla",
  "description": "Samla: self-hosted file and media platform with OIDC, WebDAV and plugin-based RBAC",
  "type": "project",
  "require": {
    "php": ">=8.4 <8.6",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "facile-it/php-openid-client": "1.0.0",
    "sabre/dav": "4.7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Samla\\Core\\": "src/",
      "Samla\\PluginApi\\": "packages/plugin-api/src/",
      "Samla\\Plugins\\Rbac\\": "plugins/rbac/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Samla\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "diagnose": "php bin/diagnose.php",
    "oidc:check": "php bin/oidc-check.php",
    "migrate": "php bin/migrate.php",
    "test:integration": "phpunit --configuration phpunit.integration.xml"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "suggest": {
    "ext-gd": "Raster image previews in the configured worker runtime",
    "ext-exif": "EXIF orientation and selected JPEG/TIFF metadata in the configured worker runtime",
    "ext-zip": "Portable ZIP exports in the configured worker runtime (libzip with cancellation support)"
  }
}
