# Copy to .env in the project root, outside the public webroot.
# Process variables override file values, including explicitly empty values.
# Values are literal; no variable interpolation or shell execution.
# Use quotes for values containing spaces or # characters.
APP_ENV=production
APP_MAINTENANCE=0
DB_ENGINE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=media_platform
DB_USER=media_platform
DB_PASSWORD=
# Optional absolute Unix socket path:
# DB_SOCKET=/run/mysqld/mysqld.sock

# Must be decided explicitly. Empty means identity access remains denied.
APP_GROUP_MAX_AGE_SECONDS=

# Used only with APP_ENV=test, never inferred from DB_*:
TEST_DB_ENGINE=mysql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=media_platform_test_local
TEST_DB_USER=media_platform_test
TEST_DB_PASSWORD=

# Local UI only: PHP's built-in server bound to loopback and a samla_dev_* database.
# Production and FPM reject this adapter even when the flag is enabled.
APP_WEB_DEV_ACCESS=0
APP_DEV_ACTOR_ID=

# OIDC protocol preparation and read-only preflight, not yet a web login switch.
# Values are trusted process variables. No real credentials belong in this file.
OIDC_ENABLED=0
OIDC_ISSUER=https://id.jrtools.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# This HTTP callback is permitted only in development/test. Production requires HTTPS.
OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
# Optional ZITADEL project audience, distinct from the ID token's client audience.
OIDC_ZITADEL_PROJECT_ID=
